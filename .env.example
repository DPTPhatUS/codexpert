# Required for Gemini
GEMINI_API_KEY=

# Required for OpenAI
OPENAI_API_KEY=

# Required for Mistral
MISTRAL_API_KEY=

# codexpert config
CODEXPERT_LLM_PROVIDER=gemini
CODEXPERT_LLM_MODEL=gemini-1.5-pro
