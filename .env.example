# CODEXPERT_LLM_MODEL=gpt-4o-mini
# CODEXPERT_LLM_PROVIDER=mistral
# CODEXPERT_LLM_MODEL=mistral-large-latest
CODEXPERT_WORKSPACE_DIR=.codexpert
CODEXPERT_TOP_K=5
CODEXPERT_MAX_ITERATIONS=6
